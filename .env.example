# ==============================================================================
# VoltIQ Platform Configuration Template (v1.0.0)
# Copy this file to .env in local environments or inject as container env vars.
# NEVER commit .env containing real credentials or secret keys to version control.
# ==============================================================================

# Server Environment Configuration
PORT=3001
NODE_ENV=production

# Security & Authentication (Required for Production Deployments)
# Generate using: openssl rand -base64 32
JWT_SECRET=your-secure-production-jwt-secret-key-here
CLIENT_ORIGIN=http://localhost:5173

# API Gateway Rate Limiting (OWASP Brute-Force & Denial-of-Service Defense)
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Indian Discom Grid & IoT Telemetry Simulator Cadence
DISCOM_SIM_INTERVAL_MS=30000
TELEMETRY_INTERVAL_MS=15000

# Static Client Path (Optional: override if custom dist folder is used)
# CLIENT_DIST_PATH=

# Frontend Client Configuration (Vite)
# Leave blank to auto-detect browser origin, or specify for remote API deployment
VITE_API_URL=
VITE_WS_URL=
